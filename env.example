# 腾讯云API配置
# 获取地址: https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=your_secret_id_here
TENCENT_SECRET_KEY=your_secret_key_here
TENCENT_REGION=ap-guangzhou
TENCENT_ENDPOINT=trtc.tencentcloudapi.com

# TRTC应用配置
# 获取地址: https://console.cloud.tencent.com/trtc/app
TRTC_SDK_APP_ID=your_sdk_app_id_here
TRTC_SECRET_KEY=xxxxx

# 服务器配置
PORT=3000
HOST=127.0.0.1 